# Copy this file to .env.local (never commit .env.local).
# Auth0: same application as Lesson 37 (Applications > ecom > Settings).
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
# Generate with: openssl rand -hex 32
AUTH0_SECRET=replace-with-a-long-random-string
APP_BASE_URL=http://localhost:3000

# MongoDB (Atlas replica set connection string, or local replica set).
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER/ecom?retryWrites=true&w=majority"

# Vercel Blob (Vercel dashboard → Storage → Blob → .env.local)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-token
